# .env configuration file for Sigma Signed-url method

# For details on embedding requirements, visit:
# https://help.sigmacomputing.com/docs/embed-url-parameters

# Required Embed Configuration
EMBED_PATH=
CLIENT_ID=
SECRET=


# Optional Embed Configuration
SESSION_LENGTH=3600

# User-Specific Parameters
EMAIL=
#EMAIL=
EXTERNAL_USER_TEAM=Client_A
#EXTERNAL_USER_TEAM=Client_B
EXTERNAL_USER_ID=
ACCOUNT_TYPE=View
MODE=userbacked

# Server Configuration
PORT=3000

#Client A Connection
eval_connection_id=
#Client B Connection
#eval_connection_id=